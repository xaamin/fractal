{
  "name": "xaamin/fractal",
  "description": "Laravel wrapper for fractal",
  "require": {
    "league/fractal": "^0.19.2",
    "illuminate/support": ">=5.0"
  },
  "authors": [
    {
      "name": "Benjamín Martínez Mateos",
      "email": "xaamin@outlook.com"
    }
  ],
  "autoload": {
    "files": [
      "helpers/fractal.php"
    ],
    "psr-4": {
      "Xaamin\\Fractal\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Xaamin\\Fractal\\Providers\\FractalServiceProvider"
      ]
    }
  },
  "require-dev": {
    "illuminate/pagination": "^13.39",
    "illuminate/database": "^13.39",
    "pestphp/pest": "^5.3",
    "phpstan/phpstan": "^2.3"
  },
  "autoload-dev": {
    "psr-4": {
      "Xaamin\\Fractal\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "analyse": "phpstan analyse --memory-limit=512M",
    "check": [
      "@analyse",
      "@test"
    ]
  }
}
